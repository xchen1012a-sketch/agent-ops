# agent-suite-web environment template.
# Copy to `.env` (local) or inject via runtime config in production.
# Only placeholders and documentation are allowed here — never real secrets.

# Base URL for the suite reverse proxy (suite-ops-nginx) that fronts all APIs.
# Dev server uses VITE_API_BASE_URL to know where to send requests.
VITE_API_BASE_URL=http://localhost

# Reverse-proxy path prefixes per module. Must align with suite-ops-nginx routing.
VITE_API_LEGAL_PREFIX=/api/legal/v1
VITE_API_RECRUITMENT_PREFIX=/api/recruitment/v1
VITE_API_DATA_PREFIX=/api/data/v1
VITE_API_AUTH_PREFIX=/api/auth

# Web session timeout (minutes) for client-side idle checks.
VITE_SESS_TIMEOUT_MINUTES=30

# Theme defaults (light / dark). Dark is beta per WEB-410 §8.
VITE_DEFAULT_THEME=light
