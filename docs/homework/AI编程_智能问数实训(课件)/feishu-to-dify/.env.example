# Service
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Feishu mode: websocket (long connection, no public URL) | webhook (future)
FEISHU_MODE=websocket

# WebSocket mode — 飞书开发者后台 → 凭证与基础信息
# 切勿将真实 Secret 提交到 Git，仅保存在本地 .env
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=your-app-secret-here
# Webhook mode only (FEISHU_MODE=webhook, future)
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

# Dify workflow app
DIFY_API_BASE=http://localhost/v1
DIFY_API_KEY=app-xxxxxxxx
DIFY_INPUT_KEY=query
DIFY_TIMEOUT=120

# Optional tuning
MSG_DEDUP_TTL=600
WS_STREAM_PUSH_INTERVAL=1.0
WELCOME_MESSAGE=你好，我是智能助手，有什么可以帮你的？
