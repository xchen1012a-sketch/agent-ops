# enterprise-agent-suite :: docker-compose top-level environment
# ===========================================================================
# Copy to .env (next to docker-compose.yml) and fill strong secrets.
# This file is the single source of truth for the compose stack; each agent
# also keeps a module-level .env (agents/<name>/.env) for its own Settings.
# Never commit any .env file with real values.
# ===========================================================================

# ---- MySQL root (only used by mysql container bootstrap + db init scripts) ----
MYSQL_ROOT_PASSWORD=__CHANGE_ME_ROOT_STRONG__

# ---- Per-account DB passwords (must match the values in scripts/db/02-create-accounts.sql) ----
LEGAL_AGENT_PASSWORD=__CHANGE_ME_LEGAL_AGENT__
LEGAL_MIGRATION_PASSWORD=__CHANGE_ME_LEGAL_MIGRATION__
RECRUITMENT_AGENT_PASSWORD=__CHANGE_ME_RECRUITMENT_AGENT__
RECRUITMENT_MIGRATION_PASSWORD=__CHANGE_ME_RECRUITMENT_MIGRATION__
DATA_QUERY_AGENT_PASSWORD=__CHANGE_ME_DATA_QUERY_AGENT__
DATA_QUERY_MIGRATION_PASSWORD=__CHANGE_ME_DATA_QUERY_MIGRATION__
DATA_QUERY_READER_PASSWORD=__CHANGE_ME_DATA_QUERY_READER__

# ---- Shared JWT secret (must be identical across the 3 agents for unified auth) ----
JWT_SECRET=__CHANGE_ME_32_BYTES_MIN__

# ---- DeepSeek (shared by all 3 agents) ----
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
