# Recruitment Assistant Agent - Environment Template
# Copy to .env and fill real values. Never commit .env.

# ---- Application ----
APP_ENV=dev
APP_NAME=recruitment-assistant-agent
APP_PORT=8102
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Auth (filled by ops, 32+ bytes random) ----
JWT_SECRET=__CHANGE_ME_32_BYTES_MIN__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---- Rate Limit ----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60

# ---- Database (recruitment_agent_db) ----
DATABASE_URL=mysql+asyncmy://recruitment_agent:__CHANGE_ME__@mysql:3306/recruitment_agent_db
DATABASE_MIGRATION_URL=mysql+asyncmy://recruitment_migration:__CHANGE_ME__@mysql:3306/recruitment_agent_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_SLOW_QUERY_SECONDS=5

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- DeepSeek ----
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_BACKOFF_SECONDS=1,2,4

# ---- Recruitment Inputs ----
UPLOAD_PATH=/app/data/uploads
SCORING_RULES_PATH=/app/data/rules/scoring-rules.yaml
MAX_RESUME_SIZE_MB=10
