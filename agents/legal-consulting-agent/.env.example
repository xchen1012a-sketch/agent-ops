# Legal Consulting Agent - Environment Template
# Copy to .env and fill real values. Never commit .env.

# ---- Application ----
APP_ENV=dev
APP_NAME=legal-consulting-agent
APP_PORT=8101
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Auth (filled by ops, 32+ bytes random) ----
JWT_SECRET=__CHANGE_ME_32_BYTES_MIN__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---- Rate Limit ----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60

# ---- Database (legal_agent_db) ----
DATABASE_URL=mysql+asyncmy://legal_agent:__CHANGE_ME__@mysql:3306/legal_agent_db
DATABASE_MIGRATION_URL=mysql+asyncmy://legal_migration:__CHANGE_ME__@mysql:3306/legal_agent_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_SLOW_QUERY_SECONDS=5

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- DeepSeek ----
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_BACKOFF_SECONDS=1,2,4

# ---- LLM Streaming Field Mapping (STREAM-100) ----
# Model-agnostic classification of streamed delta fields into thinking/answer
# channels. Comma-separated, ordered by priority. Not bound to one provider.
LLM_STREAM_THINKING_FIELDS=reasoning_content,reasoning,thinking
LLM_STREAM_ANSWER_FIELDS=content,text

# ---- Legal Knowledge Base & Hybrid Retrieval (ADR-0012) ----
LEGAL_KB_PATH=/app/data/legal_kb
HIGH_RISK_KEYWORDS_PATH=/app/data/legal_kb/high-risk-keywords.yaml

# Embedding service (HuggingFace TEI, outputs dense + sparse)
EMBEDDING_BASE_URL=http://bge-embedding:8080
EMBEDDING_MODEL=BAAI/bge-m3

# Vector store (Qdrant)
RAG_VECTOR_DB_URL=http://qdrant:6333
RAG_VECTOR_COLLECTION=legal_kb

# Hybrid retrieval weights and bounds
RAG_DENSE_WEIGHT=0.7
RAG_SPARSE_WEIGHT=0.3
RAG_RECALL_TOP_N=20
RAG_RERANK_TOP_N=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_CATEGORY_FILTER_ENABLED=true

# Cross-encoder reranker (set RAG_RERANKER_ENABLED=false to degrade gracefully)
RAG_RERANKER_ENABLED=true
RAG_RERANKER_BASE_URL=http://bge-reranker:8081
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Agent API config center (CONFIG-100): Fernet master key, 32+ bytes base64.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_CONFIG_ENCRYPTION_KEY=__CHANGE_ME_FERNET_KEY__
