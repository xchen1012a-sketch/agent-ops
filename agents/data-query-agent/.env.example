# Data Query Agent - Environment Template
# Copy to .env and fill real values. Never commit .env.

# ---- Application ----
APP_ENV=dev
APP_NAME=data-query-agent
APP_PORT=8103
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Auth (filled by ops, 32+ bytes random) ----
JWT_SECRET=__CHANGE_ME_32_BYTES_MIN__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---- Rate Limit ----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60

# ---- Database (data_query_agent_db, read-write) ----
DATABASE_URL=mysql+asyncmy://data_query_agent:__CHANGE_ME__@mysql:3306/data_query_agent_db
DATABASE_MIGRATION_URL=mysql+asyncmy://data_query_migration:__CHANGE_ME__@mysql:3306/data_query_agent_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_SLOW_QUERY_SECONDS=5

# ---- Shop DB (read-only business database) ----
SHOP_DB_READ_URL=mysql+asyncmy://data_query_reader:__CHANGE_ME__@mysql:3306/shop_db
SHOP_DB_READ_ONLY=true
SHOP_DB_POOL_SIZE=5
SHOP_DB_MAX_OVERFLOW=10
SQL_EXECUTION_TIMEOUT_SECONDS=10

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- DeepSeek ----
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_BACKOFF_SECONDS=1,2,4

# ---- SQL Safety ----
SQL_WHITELIST_PATH=/app/data/rules/sql-whitelist.yaml
INDICATORS_PATH=/app/data/rules/indicators.yaml
SQL_MAX_ROWS=1000
SQL_MAX_FIELDS=50
SQL_MAX_BYTES=1048576
SQL_AUDIT_RETENTION_DAYS=90
MCP_SERVER_URL=http://mcp-server:8080
MCP_TIMEOUT_SECONDS=30
FEISHU_ENABLED=false

# Agent API config center (CONFIG-100): Fernet master key, 32+ bytes base64.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_CONFIG_ENCRYPTION_KEY=__CHANGE_ME_FERNET_KEY__
